# قاعدة البيانات (PostgreSQL من Neon أو Supabase)
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# مزود البحث عن الصور: serpapi أو bing
IMAGE_SEARCH_PROVIDER="serpapi"
IMAGE_SEARCH_API_KEY=""

# التخزين
STORAGE_PROVIDER="vercel-blob"
BLOB_READ_WRITE_TOKEN=""

# اختياري: Rate limiting مشترك في الإنتاج
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# حدود الصور الافتراضية (يمكن تغييرها من صفحة الإعدادات)
MIN_IMAGE_WIDTH=500
MIN_IMAGE_HEIGHT=500
MAX_IMAGE_FILE_SIZE_MB=15
